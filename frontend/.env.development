# URL base absoluta del backend para desarrollo (FR-034, FR-035, FR-036).
# El frontend (Vite) y el backend (FastAPI/uvicorn) son servidores
# independientes de orígenes distintos; no hay proxy de desarrollo. Ajusta el
# puerto si tu backend local escucha en otro distinto.
VITE_API_BASE_URL=http://localhost:8000
