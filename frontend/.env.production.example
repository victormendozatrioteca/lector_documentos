# Plantilla para producción: copia este archivo a `.env.production` (no se
# versiona, ver .gitignore) y ajusta la URL real del backend desplegado.
# URL base absoluta del backend en producción (FR-034, FR-035, FR-036).
# El frontend y el backend se despliegan en orígenes distintos; no se fija un
# dominio ni puerto concretos aquí, cada despliegue define el suyo.
VITE_API_BASE_URL=https://api.tu-dominio-de-produccion.example
